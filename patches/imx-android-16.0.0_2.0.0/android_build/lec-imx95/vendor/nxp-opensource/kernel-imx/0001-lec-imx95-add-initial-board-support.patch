+	.probe = lt9611_probe,
+	.remove = lt9611_remove,
+	.shutdown = lt9611_shutdown,
+	.id_table = lt9611_id,
+};
+module_i2c_driver(lt9611_driver);
+
+MODULE_LICENSE("GPL v2");
