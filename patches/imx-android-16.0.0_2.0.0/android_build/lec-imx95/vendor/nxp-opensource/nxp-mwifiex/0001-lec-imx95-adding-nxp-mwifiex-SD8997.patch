diff --git a/Makefile b/Makefile
index dd18056..76f2549 100644
--- a/Makefile
+++ b/Makefile
@@ -37,6 +37,7 @@ CONFIG_PCIE8897=n
 CONFIG_SD8977=n
 CONFIG_SD8978=y
 CONFIG_USB8978=n
+CONFIG_SD8997=y
 CONFIG_SD8987=y
 CONFIG_SD9097=n
 CONFIG_SD9177=y
@@ -292,6 +293,10 @@ ifeq ($(CONFIG_SD8978),y)
 	CONFIG_SDIO=y
 	ccflags-y += -DSD8978
 endif
+ifeq ($(CONFIG_SD8997),y)
+	CONFIG_SDIO=y
+	ccflags-y += -DSD8997
+endif
 ifeq ($(CONFIG_SD8987),y)
 	CONFIG_SDIO=y
 	ccflags-y += -DSD8987
diff --git a/mlan/mlan_cmdevt.c b/mlan/mlan_cmdevt.c
index cb4477e..b7ce944 100644
--- a/mlan/mlan_cmdevt.c
+++ b/mlan/mlan_cmdevt.c
@@ -6222,9 +6222,10 @@ mlan_status wlan_process_vdll_event(pmlan_private pmpriv, pmlan_buffer pevent)
 		break;
 	case VDLL_IND_TYPE_INTF_RESET:
 		PRINTM(MEVENT, "VDLL_IND (INTF_RESET)\n");
-#if defined(SD8987) || defined(SD8978)
+#if defined(SD8997) || defined(SD8987) || defined(SD8978)
 		/* For SDIO, need to reset wr_port only */
-		if (IS_SD8987(pmadapter->card_type) ||
+		if (IS_SD8997(pmadapter->card_type) ||
+		    IS_SD8987(pmadapter->card_type) ||
 		    IS_SD8978(pmadapter->card_type)) {
 			pmadapter->pcard_sd->curr_wr_port =
 				pmadapter->pcard_sd->reg->start_wr_port;
diff --git a/mlan/mlan_decl.h b/mlan/mlan_decl.h
index a4ae8b2..045e900 100644
