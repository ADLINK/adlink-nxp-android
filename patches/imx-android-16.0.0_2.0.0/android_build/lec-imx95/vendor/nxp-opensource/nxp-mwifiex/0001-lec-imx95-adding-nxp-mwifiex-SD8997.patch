 	.start_rd_port = 0,
 	.start_wr_port = 0,
@@ -260,6 +261,16 @@ static const struct _mlan_sdio_card_reg mlan_reg_sd8977 = {
 };
 #endif
 
+#ifdef SD8997
+static const struct _mlan_card_info mlan_card_info_sd8997 = {
+	.max_tx_buf_size = MLAN_TX_DATA_BUF_SIZE_4K,
+	.v16_fw_api = 1,
+	.supp_ps_handshake = 0,
+	.default_11n_tx_bf_cap = DEFAULT_11N_TX_BF_CAP_2X2,
+	.support_11mc = 1,
